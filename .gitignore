# Third-party clone (someone else's repo) — not part of this project
cleanyourtv/

# WorkBuddy project memory (private, local-only)
.workbuddy/

# OS cruft
.DS_Store
__pycache__/
*.pyc

# runtime logs (apply_v2 / apply_v3 dry-run / verify / baseline)
apply_v2_*.log
apply_v3_20261019_090942.log
apply_v3_20261019_091833.log
verify_*.log
baseline_*.log

